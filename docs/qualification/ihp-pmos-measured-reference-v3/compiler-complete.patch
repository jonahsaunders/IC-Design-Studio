+//! Experimental source-only adapter; generated-code verification still required.
+//! No descriptor, persistent state, physical residual or Jacobian changes.
+use llvm::*;
+use std::ffi::CString;
+// LLVM15 llvm-c/Core.h:2277; global VALUE type is valid with opaque pointers.
+// Kept local so this experiment does not alter shared LLVM wrapper bindings.
+extern "C" {
+    fn LLVMGlobalGetValueType<'a>(global: &'a Value) -> &'a Type;
+}
+use sim_back::dae::{MatrixEntryId, SimUnknown};
+use crate::compilation_unit::OsdiCompilationUnit;
+
+pub(crate) struct Workspace<'ll> {
+    j: &'ll Value,
+    x: &'ll Value,
+    result: &'ll Value,
+}
+impl<'a, 'b, 'll> OsdiCompilationUnit<'a, 'b, 'll> {
+    pub(crate) fn compensated_enabled(&self) -> bool {
+        self.cx.target.llvm_target == "x86_64-unknown-linux-gnu"
+    }
+    pub(crate) unsafe fn compensated_workspace(&self, b: &Builder<'ll>) -> Workspace<'ll> {
+        let ty=self.cx.ty_array(self.cx.ty_double(),64);
+        Workspace { j:LLVMBuildAlloca(b,ty,UNNAMED), x:LLVMBuildAlloca(b,ty,UNNAMED),
+                    result:LLVMBuildAlloca(b,self.cx.ty_double(),UNNAMED) }
+    }
+    /// Called only in resistive pass. True means this row was fully handled,
+    /// including original no-store semantics. Arrays allocated once per callback.
+    #[allow(clippy::too_many_arguments)]
+    pub(crate) unsafe fn compensated_row(&self,node:SimUnknown,entries:&[MatrixEntryId],
+        llfunc:&'ll Value,b:&Builder<'ll>,inst:&'ll Value,model:&'ll Value,
+        dst:&'ll Value,prev:&'ll Value,w:&Workspace<'ll>) {
+        let cx=self.cx;
+        let mut pairs=Vec::new();
+        for &entry in entries {
+            if let Some(j)=self.load_jacobian_entry(entry,inst,model,b,false) {
+                let col=self.module.dae_system.jacobian[entry].col;
+                let x=self.inst_data.read_node_voltage(cx,col,inst,prev,b);
+                pairs.push((j,x));
+            }
+        }
+        let residual=self.inst_data.read_residual(node,inst,b,false);
+        // Original code ignores limiter-only row and makes no store.
+        if pairs.is_empty() && residual.is_none() { return; }
+        let limiter=self.inst_data.read_lim_rhs(node,inst,b,false);
+        let fallback=|b:&Builder<'ll>| {
+            let mut res=None;
+            for &(j,x) in &pairs {
+                let v=LLVMBuildFMul(b,j,x,UNNAMED);LLVMSetFastMath(v);
+                res=Some(if let Some(old)=res {
+                    let v=LLVMBuildFAdd(b,old,v,UNNAMED);LLVMSetFastMath(v);v
+                } else {v});
+            }
+            if let Some(r)=residual {
+                let v=LLVMBuildFSub(b,res.unwrap_or_else(||cx.const_real(0.0)),r,UNNAMED);
+                LLVMSetFastMath(v);res=Some(v);
+            }
+            let mut res=res.expect("nonempty original row");
+            if let Some(l)=limiter { res=LLVMBuildFAdd(b,res,l,UNNAMED); }
+            res
+        };
+        if residual.is_none() || pairs.is_empty() || pairs.len()>64 {
+            let res=fallback(b);
+            self.inst_data.store_contrib(cx,node,inst,dst,res,b,false);
+            return;
+        }
+        let array_ty=cx.ty_array(cx.ty_double(),64);
+        for (i,&(j,x)) in pairs.iter().enumerate() {
+            let indices=[cx.const_unsigned_int(0),cx.const_unsigned_int(i as u32)];
+            let jp=LLVMBuildGEP2(b,array_ty,w.j,indices.as_ptr(),2,UNNAMED);
+            let xp=LLVMBuildGEP2(b,array_ty,w.x,indices.as_ptr(),2,UNNAMED);
+            LLVMBuildStore(b,j,jp);LLVMBuildStore(b,x,xp);
+        }
+        let name=CString::new("openvaf_experimental_compensated_rhs").unwrap();
+        let helper=LLVMGetNamedFunction(cx.llmod,name.as_ptr()).expect("strict helper missing");
+        let ty=cx.ty_func(&[cx.ty_ptr(),cx.ty_ptr(),cx.ty_int(),cx.ty_double(),cx.ty_int(),cx.ty_double(),cx.ty_ptr()],cx.ty_int());
+        let actual_ty=LLVMGlobalGetValueType(helper);
+        assert!(std::ptr::eq(actual_ty,ty), "strict helper function signature mismatch");
+        let args=[w.j,w.x,cx.const_unsigned_int(pairs.len() as u32),residual.unwrap(),
+            cx.const_unsigned_int(u32::from(limiter.is_some())),limiter.unwrap_or_else(||cx.const_real(0.0)),w.result];
+        // Absent limiter placeholder is NOT validated or inserted by strict C helper.
+        let status=LLVMBuildCall2(b,ty,helper,args.as_ptr(),args.len() as u32,UNNAMED);
+        let ok=LLVMBuildICmp(b,IntPredicate::IntEQ,status,cx.const_unsigned_int(0),UNNAMED);
+        let success=LLVMAppendBasicBlockInContext(cx.llcx,llfunc,UNNAMED);
+        let failure=LLVMAppendBasicBlockInContext(cx.llcx,llfunc,UNNAMED);
+        let merge=LLVMAppendBasicBlockInContext(cx.llcx,llfunc,UNNAMED);
+        LLVMBuildCondBr(b,ok,success,failure);
+        LLVMPositionBuilderAtEnd(b,success);
+        let stable=LLVMBuildLoad2(b,cx.ty_double(),w.result,UNNAMED);
+        LLVMBuildBr(b,merge);
+        LLVMPositionBuilderAtEnd(b,failure);
+        // Original arithmetic exists ONLY in fallback block in emitted source IR.
+        // Later optimized-IR review must reject speculation before helper guard.
+        let original=fallback(b);LLVMBuildBr(b,merge);
+        LLVMPositionBuilderAtEnd(b,merge);
+        let value=LLVMBuildPhi(b,cx.ty_double(),UNNAMED);
+        LLVMAddIncoming(value,[stable,original].as_ptr(),[success,failure].as_ptr(),2);
+        // Destination accumulation remains exactly existing code, outside EFT bound.
+        self.inst_data.store_contrib(cx,node,inst,dst,value,b,false);
+    }
+}
