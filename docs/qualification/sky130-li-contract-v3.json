  "facts": [
    {
      "id": "identity",
      "classification": "source_defined",
      "statement": "Public documentation identifies the two-terminal local-interconnect primitive as sky130_fd_pr__res_generic_l1. The original symbol spells its model res_generic_li; the application applies an exact-source-hash-checked correction.",
      "sources": [
        "device_docs",
        "symbol",
        "model",
        "binding"
      ],
      "model": "sky130_fd_pr__res_generic_l1",
      "terminal_count": 2
    },
    {
      "id": "analog_applicability",
      "classification": "source_caution",
      "statement": "The generic-resistor documentation cautions against analog use. This contract qualifies integration of that declared device; it does not recommend it as a precision analog resistor.",
      "sources": [
        "device_docs"
      ]
    },
    {
      "id": "interface",
      "classification": "application_contract",
      "statement": "The current catalog emits an R primitive with pin order m,p and parameters w,l,m from w,l,mult. W/L are emitted numerically in micrometres. Positive real W/L/mult are catalog checks, not foundry validity bounds.",
      "sources": [
        "package",
        "symbol",
        "binding_tests"
      ],
      "pin_order": [
        "m",
        "p"
      ],
      "emit_parameters": {
        "l": "l",
        "m": "mult",
        "w": "w"
      },
      "positive_parameters": [
        "w",
        "l",
        "mult"
      ],
      "fractional_electrical_multiplicity": "accepted by catalog; complete physical equivalence not qualified"
    },
    {
      "id": "ordinary_width",
      "classification": "physical_rule",
      "statement": "Outside areaid.ed, li.7 gives minimum LI resistor width 0.290 um. Inside areaid.ed it delegates to li.1. The tested ordinary recipe adds no exception marker.",
      "sources": [
        "li_rules",
        "physical_runner",
        "historical_evidence"
      ],
      "minimum_um": 0.29,
      "rule": "li.7.-",
      "exception": "areaid.ed; applicability/creation outside current ordinary recipe remains unqualified"
    },
    {
      "id": "li_context",
      "classification": "physical_rules",
      "statement": "Adjacent LI geometry must also satisfy the listed width, spacing, enclosure and area rules; meeting the resistor width alone is insufficient.",
      "sources": [
        "li_rules"
      ],
      "ordinary_li_width_um": 0.17,
      "ordinary_spacing_um": 0.17,
      "licon_enclosure_one_of_two_adjacent_sides_um": 0.08,
      "minimum_li_area_um2": 0.0561,
      "scope": "These are selected LI table rules, not the complete required DRC rule set."
    },
    {
      "id": "li_ratio",
      "classification": "source_ambiguity",
      "statement": "li.2 records a maximum length/width ratio without licon or mcon of 10.000, flag NC, but its unit column says um. Do not infer a global resistor aspect-ratio bound or waive the rule from existing long samples; resolve segmentation/contact applicability and the unit inconsistency.",
      "sources": [
        "li_rules"
      ],
      "raw_value": "10.000",
      "raw_unit": "um",
      "raw_flag": "NC",
      "status": "unresolved_interpretation"
    },
    {
      "id": "sheet_spec",
      "classification": "published_specification",
      "statement": "The public generic-resistor table gives RSLI nominal and lower/upper specification values. It does not provide, in this table/section, the complete geometry, temperature, bias and measurement equation needed to turn them into a device pass.",
      "sources": [
        "generic_specs",
        "device_docs"
      ],
      "nominal_ohm_per_square": 12.8,
      "lower_ohm_per_square": 9.2,
      "upper_ohm_per_square": 17,
      "acceptance_status": "conditions_unresolved"
    },
    {
      "id": "model_coefficients",
      "classification": "model_definition_only",
      "statement": "The LI R model names rsh=rl1, tc1r=tc1rl1, tc2r=tc2rl1, dw=-tol_li/2-li_dw/2 and tnom=30. These are simulation coefficients/reference temperature, not a qualified temperature/current/voltage range.",
      "sources": [
        "model"
      ],
      "tc1_per_c": 0.0006045,
      "tc2_per_c2": -3.693e-07,
      "li_dw_um": 0.017,
