  "facts": [
    {
      "id": "MIM-IDENTITY",
      "kind": "source_model_interface",
      "sources": [
        "model_1",
        "model_2",
        "symbol_1",
        "symbol_2",
        "package",
        "binding_preparer"
      ],
      "claim": "Two-terminal c0/c1 subcircuits with W/L in micrometres and mf parameter. First plate uses metal3/via3; second metal4/via4. Original second symbol says VM but current reviewed adapter emits mf and simulator m; original assets remain unchanged."
    },
    {
      "id": "MIM-VOLTAGE-DOCUMENT",
      "kind": "published_family_voltage_definition_with_mapping_caveat",
      "sources": [
        "device_docs",
        "model_1",
        "model_2"
      ],
      "value": {
        "abs_terminal_difference_v": [
          0,
          5
        ]
      },
      "claim": "Public MiM section states this model-validity voltage range for CAPM over metal3 and CAP2M over metal4. Its model/cell identifiers differ from shipped wrapper names; reviewed construction identity supports a bounded family mapping, not proof of the missing parasitic or reliability behavior."
    },
    {
      "id": "MIM-PUBLIC-SPECS",
      "kind": "published_measurement_limits_with_unresolved_conditions",
      "sources": [
        "electrical_specs"
      ],
      "value": {
        "area_fF_per_um2": {
          "nominal": 2,
          "lsl": 1.8,
          "usl": 2.2
        },
        "perimeter_fF_per_um": {
          "nominal": 0.19,
          "lsl": 0.11,
          "usl": 0.27
        },
        "top_sheet_ohm_per_square": {
          "nominal": 5.8,
          "lsl": 4.8,
          "usl": 6.8
        }
      },
      "claim": "Same listed values for both constructions. Measurement temperature, bias, frequency, geometry extraction and statistical confidence are not given by this table. Do not enforce these limits directly on stress-corner coefficients or substitute top-sheet resistance for bottom-metal resistance."
    },
