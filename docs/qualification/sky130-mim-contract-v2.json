    "contact_pitch_um": {
      "1": 0.56,
      "2": 0.73
    },
    "series_resistance_ohm": "R=rmN*lc/wc+rcviaN*pitch_um^2/(wc*lc), at temp=tnom with mf=m=1",
    "admittance_s": "Y=1/(R+1/(j*2*pi*f*C0))",
    "mismatch": "C=C0*(1+MC_MM_SWITCH*AGAUSS(0,1,1)*0.028/sqrt(wc*lc*mf)); simulator m additionally multiplies complete subcircuit",
