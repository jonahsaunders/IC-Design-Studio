+/* Preserve convex fringe domains through every shielding plane.  A path
+ * intersects one tile on each plane, so its vertex count is bounded by
+ * the initial rectangle plus five clipping lines per plane and target.
+ */
+#define EXT_FRINGE_VERTICES (5 * MAXPLANES + 16)
+typedef struct { long double x, y; } extFringePoint;
+typedef struct {
+    int n;
+    extFringePoint p[EXT_FRINGE_VERTICES];
+} extFringePolygon;
+
+static void
+extFringeAppend(extFringePolygon *p, extFringePoint v)
+{
+    if (p->n && p->p[p->n - 1].x == v.x && p->p[p->n - 1].y == v.y)
+        return;
+    ASSERT(p->n < EXT_FRINGE_VERTICES, "fringe polygon capacity");
+    p->p[p->n++] = v;
+}
+
+/* Keep a*x + b*y + c >= 0, including its boundary. */
+static void
+extFringeClip(extFringePolygon *p, long double a, long double b, long double c)
+{
+    extFringePolygon q;
+    extFringePoint u, v, crossing;
+    long double du, dv, f;
+    int i;
+    if (!p->n) return;
+    q.n = 0;
+    u = p->p[p->n - 1];
+    du = a * u.x + b * u.y + c;
+    for (i = 0; i < p->n; i++)
+    {
+        v = p->p[i];
+        dv = a * v.x + b * v.y + c;
+        if ((du < 0) != (dv < 0))
+        {
+            f = du / (du - dv);
+            crossing.x = u.x + f * (v.x - u.x);
+            crossing.y = u.y + f * (v.y - u.y);
+            extFringeAppend(&q, crossing);
+        }
+        if (dv >= 0) extFringeAppend(&q, v);
+        u = v;
+        du = dv;
+    }
+    if (q.n > 1 && q.p[0].x == q.p[q.n - 1].x &&
+            q.p[0].y == q.p[q.n - 1].y) q.n--;
+    *p = q;
+}
+
+static void
+extFringeClipTile(extFringePolygon *p, Tile *tile, TileType dinfo)
+{
+    long double x = LEFT(tile), y = BOTTOM(tile);
+    long double w = (long double)RIGHT(tile) - x;
+    long double h = (long double)TOP(tile) - y;
+    long double a, b, c;
+    extFringeClip(p, 1, 0, -x);
+    extFringeClip(p, -1, 0, RIGHT(tile));
+    extFringeClip(p, 0, 1, -y);
+    extFringeClip(p, 0, -1, TOP(tile));
+    if (!IsSplit(tile)) return;
+    if (SplitDirection(tile))
+    {
+        /* The left side of a descending diagonal is the lower triangle. */
+        a = -h; b = -w; c = h*x + w*y + w*h;
+    }
+    else
+    {
+        /* The left side of an ascending diagonal is the upper triangle. */
+        a = -h; b = w; c = h*x - w*y;
+    }
+    if (dinfo & TT_SIDE) { a = -a; b = -b; c = -c; }
+    extFringeClip(p, a, b, c);
+}
+
+static void
+extFringeRect(extFringePolygon *p, const Rect *r)
+{
+    p->n = 0;
+    if (r->r_xtop <= r->r_xbot || r->r_ytop <= r->r_ybot) return;
+    p->n = 4;
+    p->p[0] = (extFringePoint){r->r_xbot, r->r_ybot};
+    p->p[1] = (extFringePoint){r->r_xtop, r->r_ybot};
+    p->p[2] = (extFringePoint){r->r_xtop, r->r_ytop};
+    p->p[3] = (extFringePoint){r->r_xbot, r->r_ytop};
+}
+
+static int
+extFringeCompare(const void *a, const void *b)
+{
+    long double x = *(const long double *)a, y = *(const long double *)b;
+    return (x > y) - (x < y);
+}
+
+static long double
+extFringeWidth(const extFringePolygon *p, long double x)
+{
+    int i, j, found = 0;
+    long double low = 0, high = 0, y;
+    for (i = 0; i < p->n; i++)
+    {
+        j = (i + 1) % p->n;
+        if (p->p[i].x == x)
+        {
+            y = p->p[i].y;
+            if (!found || y < low) low = y;
+            if (!found || y > high) high = y;
+            found = 1;
+        }
+        if ((p->p[i].x < x && p->p[j].x > x) ||
+                (p->p[j].x < x && p->p[i].x > x))
+        {
+            y = p->p[i].y + (x - p->p[i].x) *
+                (p->p[j].y - p->p[i].y) / (p->p[j].x - p->p[i].x);
+            if (!found || y < low) low = y;
+            if (!found || y > high) high = y;
+            found = 1;
+        }
+    }
+    return found ? high - low : 0;
+}
+
+/* Integral of a linearly varying width against the existing atan fringe
+ * kernel.  The small-interval branch avoids cancellation of its first
+ * moment; eight-point Gauss integration there is far below native output
+ * precision because delta/(1+a) < 1e-4.  No capacitance is clamped.
+ */
+static long double
+extFringeStrip(long double a, long double delta, long double w0, long double w1)
+{
+    static const long double x[4] = {
+        .18343464249564980494L, .52553240991632898582L,
+        .79666647741362673959L, .96028985649753623168L};
+    static const long double weight[4] = {
+        .36268378337836198297L, .31370664587788728734L,
+        .22238103445337447054L, .10122853629037625915L};
+    long double i0, i1, t, u, result = 0;
+    int k, sign;
+    if (delta <= 0) return 0;
+    i0 = atan2l(delta, 1 + a * (a + delta));
+    if (w0 == w1) return w0 * i0;
+    if (delta < 1e-4L * (1 + a))
+    {
+        for (k = 0; k < 4; k++)
+            for (sign = -1; sign <= 1; sign += 2)
+            {
+                t = (1 + sign * x[k]) / 2;
+                u = a + delta * t;
+                result += weight[k] * ((1-t)*w0 + t*w1) / (1 + u*u);
+            }
+        return result * delta / 2;
+    }
+    i1 = (0.5L * log1pl(delta * (2*a + delta) / (1+a*a)) - a*i0) / delta;
+    return w0 * (i0 - i1) + w1 * i1;
+}
+
+static long double
+extFringeIntegral(const extFringePolygon *source, Boundary *bp, long double mult)
+{
+    extFringePolygon p = *source;
+    long double values[EXT_FRINGE_VERTICES], x, y, w0, w1, result = 0;
+    int i;
+    if (p.n < 3 || mult <= 0) return 0;
+    for (i = 0; i < p.n; i++)
+    {
+        x = p.p[i].x; y = p.p[i].y;
+        switch (bp->b_direction)
+        {
+            case BD_LEFT: p.p[i].x = bp->b_segment.r_xbot - x; p.p[i].y = y; break;
+            case BD_RIGHT: p.p[i].x = x - bp->b_segment.r_xtop; p.p[i].y = y; break;
+            case BD_BOTTOM: p.p[i].x = bp->b_segment.r_ybot - y; p.p[i].y = x; break;
+            case BD_TOP: p.p[i].x = y - bp->b_segment.r_ytop; p.p[i].y = x; break;
+        }
+    }
+    extFringeClip(&p, 1, 0, 0); /* Only the outward fringe. */
+    for (i = 0; i < p.n; i++) values[i] = p.p[i].x;
+    qsort(values, p.n, sizeof(long double), extFringeCompare);
+    for (i = 1; i < p.n; i++)
+    {
+        if (values[i] <= values[i-1]) continue;
+        w0 = extFringeWidth(&p, values[i-1]);
+        w1 = extFringeWidth(&p, values[i]);
+        result += extFringeStrip(mult * values[i-1],
+                mult * (values[i] - values[i-1]), w0, w1);
+    }
+    return 0.6366L * result;
+}
+
+typedef struct {
+    extFringePolygon polygon;
+    PlaneMask planes;
+    TileTypeBitMask shields;
+    Boundary *boundary;
+    long double cmult, smult;
+    long double *coupling, *substrate;
+} extFringeSearch;
+
+static void extFringeUnshielded(extFringeSearch *search);
+
+static int
+extFringeVisit(Tile *tile, TileType dinfo, ClientData data)
+{
+    extFringeSearch *parent = (extFringeSearch *)data;
+    extFringeSearch child;
+    TileType type = IsSplit(tile) ? ((dinfo & TT_SIDE) ?
+        TiGetRightType(tile) : TiGetLeftType(tile)) : TiGetTypeExact(tile);
+    if (TTMaskHasType(&parent->shields, type)) return 0;
+    child = *parent;
+    extFringeClipTile(&child.polygon, tile, dinfo);
+    if (child.polygon.n >= 3) extFringeUnshielded(&child);
+    return 0;
+}
+
+static void
+extFringeUnshielded(extFringeSearch *search)
+{
+    Rect r;
+    int i, plane;
+    long double xmin, xmax, ymin, ymax;
+    if (search->polygon.n < 3) return;
+    for (plane = PL_TECHDEPBASE; plane < DBNumPlanes; plane++)
+        if (PlaneMaskHasPlane(search->planes, plane)) break;
+    if (plane == DBNumPlanes)
+    {
+        *search->coupling += extFringeIntegral(&search->polygon, search->boundary, search->cmult);
+        *search->substrate += extFringeIntegral(&search->polygon, search->boundary, search->smult);
+        return;
+    }
+    search->planes &= ~PlaneNumToMaskBit(plane);
+    xmin = xmax = search->polygon.p[0].x;
+    ymin = ymax = search->polygon.p[0].y;
+    for (i = 1; i < search->polygon.n; i++)
+    {
+        xmin = MIN(xmin, search->polygon.p[i].x); xmax = MAX(xmax, search->polygon.p[i].x);
+        ymin = MIN(ymin, search->polygon.p[i].y); ymax = MAX(ymax, search->polygon.p[i].y);
+    }
+    r.r_xbot = (int)floorl(xmin); r.r_xtop = (int)ceill(xmax);
+    r.r_ybot = (int)floorl(ymin); r.r_ytop = (int)ceill(ymax);
+    if (r.r_xtop <= r.r_xbot || r.r_ytop <= r.r_ybot) return;
+    DBSrPaintArea((Tile *)NULL, extOverlapDef->cd_planes[plane], &r,
+            &DBAllTypeBits, extFringeVisit, (ClientData)search);
+}
