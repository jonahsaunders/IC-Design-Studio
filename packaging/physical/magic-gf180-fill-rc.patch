+static int
+resRecordCrossPlane(Tile *tile, TileType dinfo, ClientData data)
+{
+    ResCrossPlane *record = (ResCrossPlane *)data;
+    HashEntry *entry = HashFind(record->table, (char *)tile);
+    resDevTerm *item = (resDevTerm *)mallocMagic(sizeof(resDevTerm));
+    item->rdt_term = record->terminal;
+    item->rdt_tile = record->device;
+    item->rdt_next = (resDevTerm *)HashGetValue(entry);
+    HashSetValue(entry, (char *)item);
+    return 0;
+}
