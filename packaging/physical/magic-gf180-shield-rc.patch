+/* Integer coverage avoids cancellation when rectangular shields completely
+ * cover the fringe search area.  Split tiles disable this exact shortcut.
+ * No capacitance tolerance is used; partial coverage keeps the original model.
+ */
+static unsigned long long
+extSideRectArea(const Rect *r)
+{
+    if (r->r_xtop <= r->r_xbot || r->r_ytop <= r->r_ybot) return 0;
+    return ((unsigned long long)((long long)r->r_xtop - r->r_xbot)) *
+           ((unsigned long long)((long long)r->r_ytop - r->r_ybot));
+}
