C {devices/code_shown.sym} 2050 -680 0 0 {name="NGSPICE" only_toplevel="true" value="* =====================================================================
* GF180 BANDGAP — FULL CHARACTERIZATION V5, 5-V-CAPABLE LOW-TC CORE
*
* Basis:
*   - latest cumulative handoff
*   - full2/full-characterization testbench structure
*   - current accepted rounded MOS geometry
*   - low-TC resistor point XR1=21.05 um, XR2=192.50 um
*
* REQUIRED FUNCTIONAL RANGE:
*   VDD = 3.0 to 5.0 V
*   T   = -40 to 125 C
*
* ROBUSTNESS ONLY:
*   VDD = 5.5 V
*
* WORKING SPEC TARGETS:
*   VREF            1.194 / 1.200 / 1.206 V
*   initial accuracy +/-0.5 %
*   IDD              20 / 30 / 50 uA  (project interpretation still open)
*   line regulation  0.01 / 0.05 / 0.1 % (endpoint interpretation used)
*   PSRR             60 / 70 / 80 dB   (frequency not yet specified)
*   noise            20 / 50 / 100 nV/sqrt(Hz) (frequency not yet specified)
*   TC               10 / 20 / 30 ppm/C
*   startup          50 / 100 / 200 us
*   IREF             180 / 220 / 260 nA
*
* IMPORTANT METHODOLOGY:
*   - clean DC/temp/line characterization uses fresh reset -> direct dc.
*   - no transient or op is allowed before authoritative clean DC sweeps.
*   - startup is characterized with a real supply ramp from 0 V.
*   - final startup leakage is SIGNED avg(i(VSTARTSENSE)).
*   - 5.5 V is reported separately and is not included in required-range
*     optimization/pass-fail.
*   - load tests are diagnostic only because no final load spec exists.
*   - output noise is intentionally in a separate validated-minimal deck.
*   - process corners are separate because .lib sections are parse-time.
*   - integrated loop gain is separate because the loop-break location must
*     be explicitly inserted/validated; do not infer PM from standalone OTA.
*
* OUTPUT DIRECTORY:
*   /foss/designs/chipalooza-bandgap/full_characterization_v5_5v
* =====================================================================

.include /foss/pdks/gf180mcuD/libs.tech/ngspice/design.ngspice
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice typical
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice bjt_typical
.lib /foss/pdks/gf180mcuD/libs.tech/ngspice/sm141064.ngspice res_typical

.options tnom=25

.param sw_stat_global=0
.param sw_stat_mismatch=0
.param fnoicor=0

* Current low-TC resistor target.  These parameters are documentary if the
* schematic uses fixed physical lengths.
.param XR1_L_UM=21.05
.param XR2_L_UM=192.50

.param VDD_RUN=5.0
.param P_ILOAD_DC=0
.param P_ILOAD_STEP=0
.param P_ZAC=0

* Testbench-only loads/injection.
ITBLOADDC   vref 0 DC \{P_ILOAD_DC\}
ITBLOADSTEP vref 0 PWL(0 0 2m 0 2001u \{P_ILOAD_STEP\} 2500u \{P_ILOAD_STEP\} 2501u 0)
ITBZ        vref 0 DC 0 AC \{P_ZAC\}

.control
set noaskquit
set temp=25
save all
tran 100n 3m
meas tran vref_final avg v(vref) from=2800u to=3000u
meas tran supply_final avg v(avdd) from=2800u to=3000u
.endc
"}
