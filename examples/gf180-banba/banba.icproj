      "annotations": [
        {
          "id": "5e1450eb875548f8",
          "x": 40,
          "y": 0,
          "text": "TWO-STAGE ERROR AMPLIFIER\nPMOS input pair for low common mode.\nVA rising relative to VB lowers OUT."
        },
        {
          "id": "33c51ca5266945fc",
          "x": 430,
          "y": 0,
          "text": "Independent resistor bias starts at VDD.\nPBIAS: 4/4 µm; tail: 8/4 µm.\nInput pair: 24/2 µm, matched."
        },
        {
          "id": "c3b56fe2fa374ba4",
          "x": 830,
          "y": 0,
          "text": "Second stage reaches the PMOS gates.\nMIM Miller capacitor ≈ 2 pF.\nLoop stability still requires verification."
        }
      ],
