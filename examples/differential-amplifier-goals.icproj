      "specifications": [
        {
          "name": "Differential gain",
          "expression": "final(abs((V(\"outn\")-V(\"outp\"))/(V(\"inp\")-V(\"inn\"))))",
          "min": "5",
          "max": "12",
          "unit": "1"
        }
      ],
      "plot_layouts": [
        {
          "name": "Differential gain (dB)",
          "expression": "db20((V(\"outn\")-V(\"outp\"))/(V(\"inp\")-V(\"inn\")))"
        },
        {
          "name": "Differential phase (rad)",
          "expression": "phase((V(\"outn\")-V(\"outp\"))/(V(\"inp\")-V(\"inn\")))"
        }
      ],
